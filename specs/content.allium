-- allium: 3
-- content.allium
--
-- Scope: The content & serving model for kirahowe.com — what the
--   published site is made of and how visitors see it: entry display
--   semantics, static pages, the URL scheme, archives, tag pages,
--   search, the Atom feeds, and the email follow offer.
-- Includes: visitor-facing surfaces over the shared Entry model,
--   the Page entity, canonical URLs (including cross-posts whose
--   canonical home is elsewhere, and previous-URL redirects),
--   404 semantics, feed shape, search contract, caching posture, and
--   the site's one handoff of visitor data to a third party (/follow).
-- Excludes:
--   - Authoring and publishing: since 2026-08-06 those live in the
--     admin app (repo website-admin, specs/authoring.allium there)
--   - Keeping the served content fresh (publishing.allium)
--   - Dev-only conveniences: live reload, per-request reindexing,
--     /drafts previews
--   - Frontmatter dialect details (YAML vs legacy EDN both parse to
--     the same Entry; which dialect a file uses is implementation)
--   - Search ranking internals (deliberately black-boxed: the
--     contract is fixed, the scoring is free to evolve)
-- Dependencies: the shared Entry model in entries.allium.
--
-- (Two drifts elicited 2026-07-17 are resolved: the nav now hides
-- entry types with no published entries — @guarantee NavHidesEmptyTypes,
-- implemented 2026-07-18 — and the README's /notes table was corrected;
-- no :note type exists or is planned.)

use "./entries.allium" as entries

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- Anyone reading the published site.
external entity Visitor {}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- A static page: pages/<slug>.md, served at /<slug> (e.g. /about).
-- Pages have no draft stage and no date; they reach the site through
-- the same public content repo as entries.
entity Page {
    slug: String                    -- the filename (minus .md)
    explicit_title: String?         -- the `title` property
    body: String

    -- Derived
    display_title: explicit_title ?? capitalize(slug)   -- capitalize: black box
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    home_entries: Integer = 10      -- the home feed shows at least this many recent
                                    -- entries, rounded up to whole days
    feed_entries: Integer = 20      -- how many recent entries the Atom feed carries
    page_entries: Integer = 10      -- how many entry previews a paginated listing
                                    -- carries before the rest go to /page/N
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule VisitorSearches {
    when: VisitorSearches(visitor, query, type_filter?, tag_filter?)
    ensures: SearchResultsReturned(
        visitor: visitor,
        results: search_results(query, type_filter, tag_filter)
    )
    @guidance
        -- search_results is a black box with a fixed contract: every
        -- query term must appear somewhere in an entry (title, tags or
        -- body); results cover published entries only, ranked by a
        -- relevance measure that is free to evolve. type_filter and
        -- tag_filter narrow the results; an unknown type_filter is
        -- ignored rather than an error. Facet counts by type and tag
        -- are offered alongside the results.
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- The site as a whole: the home feed, navigation, and the promises
-- the pipeline makes about it being up and fresh.
surface PublishedSite {
    facing visitor: Visitor

    let published = entries/Entries where status = published

    exposes:
        for entry in published:
            entry.display_title
            entry.type
            entry.tags
            entry.published_date

    @guarantee AlwaysUp
        -- A failed content sync never takes the site down: the last
        -- good index keeps serving, the sync retries every tick, and a
        -- broken clone at boot serves an empty site rather than
        -- crash-looping. (Backed by the Server rules in
        -- publishing.allium.)
    @guarantee EventualFreshness
        -- A pushed change is live within seconds: the content repo's
        -- push webhook pokes the server, which refreshes at once (see
        -- publishing's ContentRefreshEndpoint). No deploy, no manual
        -- step. Should a webhook delivery never arrive, publishing's
        -- content_sync_interval is the outside bound.
    @guarantee NavHidesEmptyTypes
        -- The navigation lists only entry types with at least one
        -- published entry, in the configured nav order.
    @guarantee CdnFriendly
        -- Every public page carries CDN-friendly cache headers, so a
        -- CDN in front absorbs traffic spikes; search results and
        -- draft previews are never cached. Pages link static assets by
        -- content-hashed URLs (?v=), served immutable — a changed
        -- asset is a new URL, so a cache can never serve it stale.
    @guarantee StrayFilesAreHarmless
        -- Markdown files that are neither dated entries, drafts nor
        -- pages are ignored; a stray file cannot break the
        -- site. The server also refuses to index content whose entry
        -- URLs collide (the last good index keeps serving).
    @guarantee EveryPageDeclaresItsUrl
        -- Every public page declares its own absolute URL as canonical
        -- in its markup; a facetted listing variant (?tag=) declares
        -- the clean listing. The one exception: an entry with a
        -- canonical_url declares that instead (see EntryPage).
    @guarantee AnalyticsHonoursDoNotTrack
        -- The site's only measurement is a self-hosted, aggregate beacon
        -- on every page — no third-party tracker, no advertising cookie,
        -- no profile of a visitor — and a browser that sends Do Not
        -- Track is not counted at all.
    @guidance
        -- The home page is a front page, not page one of the stream:
        -- it shows at least config.home_entries recent entries, rounded
        -- up to whole days, and when more exist it ends with one link
        -- to the archive index rather than paginating or continuing
        -- into a month. The production server exposes no admin surface.
}

-- A single published entry at its canonical URL.
surface EntryPage {
    facing visitor: Visitor

    context entry: entries/Entry where status = published

    exposes:
        entry.display_title
        entry.type
        entry.body                   -- rendered; wikilinks resolved, images from /attachments/
        entry.tags
        entry.published_date
        entry.link_url
        entry.via_url
        entry.attribution
        entry.attribution_url
        entry.canonical_url

    @guarantee CanonicalUrl
        -- Exactly one canonical URL per entry:
        -- /YYYY/<short month name>/<D>/<slug>. Other spellings of the
        -- same date (e.g. numeric month, zero-padded day) permanently
        -- redirect to it. A pinned_slug keeps a URL inherited from an
        -- old blog working forever.
    @guarantee PreviousUrlsRedirect
        -- Every previous_url on the site's own host permanently
        -- redirects to the entry — consulted only where the site would
        -- otherwise 404, so an old URL can never shadow live content.
        -- Foreign-host previous_urls are the old domains' redirects to
        -- serve; `bb redirects` exports them (Cloudflare bulk-redirect
        -- CSV). A previous URL that is blank, already live, or claimed
        -- by two entries fails indexing loudly.
    @guarantee CrossPostsPointHome
        -- An entry with a canonical_url declares that URL — not its
        -- own — as the content's canonical location in its markup, and
        -- credits the original visibly on the page.
    @guarantee WikilinksNeverDangle
        -- [[wikilinks]] resolve by filename to the target entry's URL;
        -- an unresolved link renders as plain text, never a dead link.
    @guidance
        -- Display follows the type: a post previews its opening in the
        -- feed and offers the rest behind a reading-time link, while the
        -- short forms publish whole there — a note, being one thought,
        -- carries its full body with its links and emphasis intact and
        -- offers no onward link. Quotes render as a large blockquote,
        -- titled by their filename (or explicit_title) like any entry,
        -- with an attribution cite line linking to attribution_url; links
        -- point out to link_url and credit via_url on the cite line. A
        -- tool credits its source code (attribution_url) as a (source)
        -- link after the title, styled like the via credit. Each
        -- entry links its newer and older neighbours in date order.
}

-- Date, type and tag listings.
surface Archives {
    facing visitor: Visitor

    let published = entries/Entries where status = published

    exposes:
        for entry in published:
            entry.display_title
            entry.type
            entry.published_date
            entry.tags

    @guarantee EmptyArchivesAre404
        -- An archive URL with no matching entries returns 404: an
        -- empty year, month, day, type or tag page is
        -- indistinguishable from a mistyped URL.
    @guidance
        -- /YYYY, /YYYY/<mon> and /YYYY/<mon>/<D> are the date archives;
        -- /posts, /links, ... list by type (optionally year-scoped as
        -- /YYYY/posts); /tags is the tag index with counts, /tags/<tag>
        -- the entries for one tag (optionally year-scoped as
        -- /tags/<tag>/YYYY). /archive redirects to the most recent year
        -- that has content. Every listing that shows entry previews —
        -- type listings, month and day archives, tag pages — carries at
        -- most config.page_entries of them and puts the older ones on
        -- stable /page/N URLs, page 1 keeping the listing's own URL. The
        -- year overview lists bare titles rather than previews and is
        -- not paginated.
}

-- Full-text search.
surface SearchPage {
    facing visitor: Visitor

    provides:
        VisitorSearches(visitor, query, type_filter?, tag_filter?)

    @guarantee NeverCached
        -- Search responses are never cached.
}

-- Atom feeds: the whole site at /feed.xml, entry types at
-- /posts/feed.xml (and equivalent plural type paths), and tags at
-- /tags/<tag>/feed.xml.
surface Feed {
    facing visitor: Visitor

    let published = entries/Entries where status = published

    exposes:
        for entry in published:
            entry.display_title
            entry.body
            entry.published_date
            entry.type
            entry.tags
            entry.link_url
            entry.via_url
            entry.attribution
            entry.attribution_url
            entry.canonical_url

    @guarantee FullBodies
        -- Feed items carry the entry's full rendered body, wikilinks
        -- resolved — no truncation, no click-through teaser.
    @guarantee StableItemIdentity
        -- Each item's identity is the entry's absolute canonical URL.
    @guarantee SelfContainedItems
        -- Every link and image reference inside an item's body is an
        -- absolute URL. A reader renders that body in its own document,
        -- where a root-relative /attachments/x.jpg would resolve against
        -- the reader's host, so every image and internal link would
        -- arrive broken.
    @guarantee ItemsCarryTheirMetadata
        -- An item carries everything the entry's page shows around its
        -- body: its type, its tags, and every credit it holds — what it
        -- links out to, where it was found (via_url), a tool's source
        -- code, a quote's attribution, a cross-post's canonical home.
        -- Each of these reaches a reader twice over: once structurally,
        -- as categories and typed links a reader's software can act on,
        -- and once visibly inside the item body, because most readers
        -- show a visitor nothing but that body. A credit shown on the
        -- page but missing from the feed is a defect, in either
        -- direction: page and feed render one description of an entry's
        -- metadata, so neither can carry a fact the other doesn't.
    @guidance
        -- Atom 1.0; the config.feed_entries most recent entries,
        -- newest first. Every feed — the site's, a type's, a tag's —
        -- is the same channel over a different set of entries, so all
        -- of the above holds equally of each. An item's body is the
        -- entry as the site renders it: a quote travels as its
        -- blockquote and attribution line, not as bare words.
}

-- /follow: the email subscription offer. Its prose is a page from the
-- content repo; the form is the site's, and this is the only place the
-- site hands a visitor's data to anyone else.
surface Follow {
    facing visitor: Visitor

    context page: Page where slug = "follow"

    exposes:
        page.display_title
        page.body

    @guarantee OneNamedRecipient
        -- A submitted address goes to Buttondown — the email service
        -- /privacy names — and nowhere else. It is the only visitor data
        -- the site hands to a third party anywhere on the site.
    @guarantee TheSiteKeepsNothing
        -- The address never reaches this site: the form submits straight
        -- to the named service, and the site has no store to put an
        -- address in. With no account configured the form is inert — it
        -- posts nowhere rather than somewhere unnamed.
    @guarantee FollowingCostsNoAddress
        -- Wherever the signup appears, the Atom feed is offered beside
        -- it — the whole site's, or the feed for the type or tag being
        -- read — so a visitor can follow without handing over anything.
    @guarantee CollectionIsExplained
        -- Where the address is asked for, the account of what becomes of
        -- it — who receives it, what it is used for, how to stop — is
        -- one link away at /privacy, which every page's footer carries.
    @guidance
        -- The page's prose is pages/follow.md, edited in the content
        -- repo like any other page; the form sits between its body and
        -- its closing note, so the prose leads into the ask and the
        -- reassurance follows it. The same signup widget appears in the
        -- sidebar of every archive and index page and in the footer of
        -- every entry page.
        --
        -- Note where FollowingCostsNoAddress comes from. Everywhere the
        -- widget appears, the widget itself carries the feed offer. On
        -- /follow it is the page's own prose that names the feeds — so
        -- that guarantee is one an edit in the content repo can quietly
        -- break, and the only surface where code does not hold it up.
}

-- Static pages such as /about.
surface StaticPage {
    facing visitor: Visitor

    context page: Page

    exposes:
        page.slug                    -- doubles as the page's URL: /<slug>
        page.display_title
        page.body
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- Follow's failure modes are unwritten. With no account configured the
-- form is inert, so a visitor who types an address and presses Subscribe
-- is answered by nothing at all; and when the form does submit, both the
-- confirmation and any refusal come from the subscription service's own
-- page, not from here.
open question "Follow: what does a visitor see when an address cannot be submitted, or is refused?"
